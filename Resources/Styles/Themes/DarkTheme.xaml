<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- DARK THEME (GitHub Dark, zielone akcenty) -->
    
    <Color x:Key="PrimaryAccent">#238636</Color>
    <Color x:Key="PrimaryAccentDark">#1A6428</Color>
    
    <!-- Tła -->
    <Color x:Key="AppBackground">#0D1117</Color>
    <Color x:Key="CardBackground">#161B22</Color>
    <Color x:Key="CardBackgroundSecondary">#161B22</Color>
    
    <!-- Ramki -->
    <Color x:Key="BorderColor">#30363D</Color>
    <Color x:Key="CardBorderColor">#30363D</Color>

    <!-- Tekst na głównym tle -->
    <Color x:Key="TextPrimary">#E6EDF3</Color>
    <Color x:Key="TextSecondary">#8B949E</Color>
    
    <!-- Tekst na zielonym kafelku -->
    <Color x:Key="TextOnCardPrimary">#FFFFFF</Color>
    <Color x:Key="TextOnCardSecondary">#A3E3B6</Color>

    <Color x:Key="DockBackground">#161B22</Color>

    <!-- Stałe -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="{StaticResource CardBackgroundSecondary}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    
    <SolidColorBrush x:Key="TextOnCardPrimaryBrush" Color="{StaticResource TextOnCardPrimary}"/>
    <SolidColorBrush x:Key="TextOnCardSecondaryBrush" Color="{StaticResource TextOnCardSecondary}"/>
    
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccent}"/>

</ResourceDictionary>
