<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RoutineKeeper.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RoutineKeeper"
    xmlns:views="clr-namespace:RoutineKeeper.Views"
    Title="RoutineKeeper">


    <TabBar>
        <Tab Title="Dashboard">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Chat">
            <ShellContent ContentTemplate="{DataTemplate views:ChatPage}" Route="ChatPage" />
        </Tab>
        <Tab Title="Planner">
            <ShellContent ContentTemplate="{DataTemplate views:SchedulePage}" Route="SchedulePage" />
        </Tab>
        <Tab Title="Notes">
            <ShellContent ContentTemplate="{DataTemplate views:NotesPage}" Route="NotesPage" />
        </Tab>
    </TabBar>

</Shell>
