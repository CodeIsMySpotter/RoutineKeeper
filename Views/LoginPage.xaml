<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:RoutineKeeper.ViewModels"
             x:Class="RoutineKeeper.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{DynamicResource AppBackground}">

    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="40" Padding="30">
            
            <!-- App logo / icon -->
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                <Border WidthRequest="100" HeightRequest="100" StrokeShape="RoundRectangle 24" BackgroundColor="{DynamicResource PrimaryAccent}" StrokeThickness="0" HorizontalOptions="Center" Shadow="{Shadow Brush={StaticResource PrimaryAccent}, Offset='0,10', Radius=20, Opacity=0.3}">
                    <Label Text="RK" FontSize="36" FontFamily="OpenSansSemibold" TextColor="{DynamicResource White}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="RoutineKeeper" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                <Label Text="Your intelligent habit assistant." FontSize="14" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Google Sign-In button -->
            <Border StrokeThickness="1" Stroke="{DynamicResource BorderColor}" BackgroundColor="{DynamicResource CardBackgroundSecondary}" StrokeShape="RoundRectangle 16" HeightRequest="56" WidthRequest="260" Margin="0, 40, 0, 0" Shadow="{Shadow Brush={StaticResource Black}, Offset='0,4', Radius=10, Opacity=0.05}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LoginCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0" Text="G" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#4285F4" VerticalOptions="Center" Margin="20,0,0,0" />
                    <Label Grid.Column="1" Text="Sign in with Google" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#757575" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,20,0" />
                </Grid>
            </Border>

            <!-- Loader (visible while signing in) -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
