<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RoutineKeeper.Views"
             xmlns:models="clr-namespace:RoutineKeeper.Models"
             x:Class="RoutineKeeper.Views.NotesPage"
             Title="Notes"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    
    <ContentPage.Resources>
        <DataTemplate x:Key="AddNoteTemplate">
            <Border HeightRequest="150" BackgroundColor="{DynamicResource CardBackgroundSecondary}" Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" StrokeShape="RoundRectangle 24" StrokeDashArray="4,4" Margin="0,0,0,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BindingContext.NoteTappedCommand, Source={RelativeSource AncestorType={x:Type views:NotesPage}}}" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="+" FontSize="48" TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                    <Label Text="New note" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NormalNoteTemplate">
            <Border HeightRequest="150" BackgroundColor="{DynamicResource PrimaryAccent}" StrokeThickness="0" StrokeShape="RoundRectangle 24" Margin="0,0,0,16" Shadow="{Shadow Brush={StaticResource Black}, Offset='0,5', Radius=15, Opacity=0.1}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BindingContext.NoteTappedCommand, Source={RelativeSource AncestorType={x:Type views:NotesPage}}}" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Padding="16" Spacing="8" VerticalOptions="Start">
                    <Label Text="{Binding Title}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{DynamicResource White}" MaxLines="2" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Content}" FontSize="12" TextColor="{DynamicResource White}" Opacity="0.8" MaxLines="4" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <views:NoteTemplateSelector x:Key="NoteTemplateSelector"
                                    AddNoteTemplate="{StaticResource AddNoteTemplate}"
                                    NormalNoteTemplate="{StaticResource NormalNoteTemplate}" />
    </ContentPage.Resources>

    <Grid BackgroundColor="{DynamicResource AppBackground}">
        <ScrollView Padding="24,60,24,100">
            <VerticalStackLayout Spacing="24">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Notes" FontSize="32" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Your shopping lists, recipes and thoughts." 
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>
                
                <CollectionView ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteTemplateSelector}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="16" VerticalItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Floating Dock -->
        <views:FloatingDock ActivePage="Notes" />
    </Grid>
</ContentPage>
